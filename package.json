{
  "name": "local-pi",
  "version": "0.1.0",
  "private": true,
  "description": "A personal TUI coding assistant built on the Pi SDK",
  "type": "module",
  "bin": {
    "local-pi": "./dist/main.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node src/main.ts",
    "check": "tsc --noEmit",
    "build": "tsc",
    "test": "node --test --test-concurrency=4 test/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
